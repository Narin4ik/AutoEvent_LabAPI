<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The pure audio pipeline from the game's net48 package runs without Unity on the test host. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SecretLabNAudio.Core" Version="2.1.2" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <Compile Include="../AutoEvent/Integrations/Audio/AudioSourceFactory.cs" Link="AudioSourceFactory.cs" />
    <Compile Include="../AutoEvent/API/MusicManager.cs" Link="MusicManager.cs" />
    <EmbeddedResource Include="../AutoEvent/Music/human_death_01.ogg" LogicalName="AutoEvent.Music.human_death_01.ogg" />
  </ItemGroup>
</Project>
